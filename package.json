{
  "name": "shade",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:contracts": "cd contracts && forge test",
    "typecheck": "tsc --noEmit",
    "build:contracts": "cd contracts && forge build",
    "deploy:contracts": "tsx script/deploy.ts",
    "verify:contracts": "bash script/verify.sh",
    "demo": "tsx script/demo.ts",
    "demo:agents": "tsx script/agents-demo.ts",
    "latency": "tsx script/latency.ts",
    "vercel:setup": "bash script/vercel.sh setup",
    "vercel:env": "bash script/vercel.sh env",
    "deploy:vercel": "bash script/vercel.sh deploy"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.49",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@openzeppelin/contracts": "^5.6.1",
    "ai": "^7.0.107",
    "dotenv": "^18.0.1",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.56.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "description": "Shade: private settlement rail for autonomous agent commerce on Monad",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20"
  }
}
