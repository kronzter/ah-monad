# Copy to .env and fill in. Never commit .env.
NETWORK=monad-testnet

# Optional private RPC (Alchemy, dRPC, QuickNode...). The public endpoint is capped at 50 calls/s
# and 100-block getLogs ranges, so a private RPC makes bursts faster and more reliable.
# RPC_URL=https://...

# Funded Monad testnet key(s) used as the relayer. Keep >10 MON on it (Monad's reserve floor),
# ~1.2 MON is spent per 50-decoy burst. Testnet faucets: see https://docs.monad.xyz
RELAYER_PKS=0xYOUR_TESTNET_PRIVATE_KEY

# Agents (any model with tool calling). Thinking mode is disabled in code.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Any long random string. Makes the demo's supplier/vault identities deterministic so every
# serverless instance agrees (REQUIRED on hosts like Vercel). Optional locally.
DEMO_SEED=

# Refuse bursts when the relayer drops below this many MON (guards the 10 MON reserve floor).
MIN_RELAYER_MON=10.5
